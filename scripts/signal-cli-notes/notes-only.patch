+    private void downloadNoteAttachments(final List<SignalServiceAttachment> attachments) {
+        if (attachments.isEmpty()) {
+            return;
+        }
+        final var helper = context.getAttachmentHelper();
+        final var paths = new HashSet<java.io.File>();
+        boolean independent = true;
+        for (var attachment : attachments) {
+            // Repeated pointers share output files; retain serial handling for these albums.
+            if (!attachment.isPointer() || !paths.add(helper.getAttachmentFile(attachment.asPointer()))) {
+                independent = false;
+            }
+        }
+        final int workers = independent ? Math.min(4, attachments.size()) : 1;
+        final long started = System.nanoTime();
+        System.err.printf("SB_NOTE_MEDIA files=%d workers=%d%n", attachments.size(), workers);
+        final var tasks = new ArrayList<Callable<Void>>();
+        for (int index = 0; index < attachments.size(); index++) {
+            final var attachment = attachments.get(index);
+            final int ordinal = index + 1;
+            tasks.add(() -> {
+                final long fileStarted = System.nanoTime();
+                try {
+                    helper.downloadAttachment(attachment);
+                } finally {
+                    System.err.printf("SB_NOTE_MEDIA file=%d total=%d elapsed_ms=%d%n",
+                            ordinal, attachments.size(), (System.nanoTime() - fileStarted) / 1_000_000);
+                }
+                return null;
+            });
+        }
+        try {
+            if (workers == 1) {
+                for (var task : tasks) {
+                    task.call();
+                }
+            } else {
+                // The per-album executor is closed before protocol processing or JSON output resumes.
+                try (var executor = Executors.newFixedThreadPool(workers)) {
+                    for (var result : executor.invokeAll(tasks)) {
+                        result.get();
+                    }
+                }
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("Note attachment downloads interrupted", e);
+        } catch (ExecutionException e) {
+            throw new IllegalStateException("Note attachment download failed", e.getCause());
+        } catch (Exception e) {
+            throw new IllegalStateException("Note attachment download failed", e);
+        } finally {
+            System.err.printf("SB_NOTE_MEDIA files=%d workers=%d elapsed_ms=%d%n",
+                    attachments.size(), workers, (System.nanoTime() - started) / 1_000_000);
+        }
+    }
